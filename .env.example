# Copy to .env or set in your hosting provider's dashboard
PORT=3000
NODE_ENV=production
# Long random string; generated automatically and persisted in DATA_DIR if omitted
JWT_SECRET=
# Where SQLite DB, uploaded invoices and the generated secret live (must be persistent!)
DATA_DIR=./data
# Set to 1 ONLY if you host without HTTPS (e.g. plain http:// on a LAN)
INSECURE_COOKIES=
# Email reminders are ON once MAIL_FROM is set (e.g. noreply@yourdomain.ro).
# Sends via the local sendmail binary by default (cPanel/most Linux hosts);
# set SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS to use an SMTP server instead.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional: require ?token= on /api/cron/email-reminders
CRON_TOKEN=
